/* MAIN.CLIST - Entry Point for Data Processing Utility */
/* Orchestrates the execution of Parser, Validator, Transformer, and Reporter */

/* Parse Input Parameters */
IF &PARM0 = '' THEN GOTO USAGE

/* Set default paths */
IF &PARM1 = '' THEN SET PPARMLIB=TSOHLQ.LISTLIB.CLIST.PARSER
IF &PARM2 = '' THEN SET PVALIDLIB=TSOHLQ.LISTLIB.CLIST.VALIDATOR
IF &PARM3 = '' THEN SET PTRANSLIB=TSOHLQ.LISTLIB.CLIST.TRANSFORMER
IF &PARM4 = '' THEN SET PREPORTLIB=TSOHLQ.LISTLIB.CLIST.REPORTER

/* Step 1: Parse Data */
EXECUTE &PPARMLIB
IF &SYSRC > 0 THEN GOTO CLEANUP

/* Step 2: Validate Data */
EXECUTE &PVALIDLIB
IF &SYSRC > 0 THEN GOTO CLEANUP

/* Step 3: Transform Data */
EXECUTE &PTRANSLIB
IF &SYSRC > 0 THEN GOTO CLEANUP

/* Step 4: Report Results */
EXECUTE &PREPORTLIB
IF &SYSRC > 0 THEN GOTO CLEANUP

GOTO SUCCESS

:USAGE
PUT CENTER CLIST 'Usage: EXEC main.clist [parse_lib] [valid_lib] [trans_lib] [report_lib]'
GOTO END

:CLEANUP
PUT CENTER CLIST 'Data processing finished with errors. Check logs.'
GOTO END

:SUCCESS
PUT CENTER CLIST 'Data processing completed successfully.'
GOTO END

:END
/* End of Main */
