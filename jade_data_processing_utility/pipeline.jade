// Pipeline management for data processing
import { DataValidator } from './validator.jade';

export class Pipeline {
    constructor(data) {
        this.data = data;
        this.steps = [];
    }

    addStep(step) {
        this.steps.push(step);
    }

    execute() {
        let result = this.data;
        for (const step of this.steps) {
            result = step(result);
        }
        return result;
    }

    getData() {
        return this.data;
    }

    setData(data) {
        this.data = data;
    }
}
