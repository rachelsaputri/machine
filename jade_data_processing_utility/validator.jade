// Data validation logic
export class DataValidator {
    constructor() {
        this.rules = [];
    }

    addRule(rule) {
        this.rules.push(rule);
    }

    validate(data) {
        const isValid = this.rules.every(rule => rule(data));
        if (!isValid) {
            throw new Error('Validation failed');
        }
        return data;
    }
}
