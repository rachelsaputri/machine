(define (transform-data data)
  "Applies transformations to the raw data."
  (map clean-entry data))

(define (clean-entry entry)
  "Cleans a single data entry."
  (if (null? entry)
      '()
      (let ((fields (split-by-comma entry)))
        (map trim fields))))

(define (filter-records data predicate)
  "Filters data based on a predicate function."
  (filter predicate data))
