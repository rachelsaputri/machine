(define (init-reporter output-path)
  "Initializes the reporting subsystem."
  (list :path output-path :success-count 0 :error-count 0))

(define (report-clean reporter data)
  "Logs successfully processed records."
  (update-counts reporter 'success (length data))
  (append-to-file (: path reporter)
                  (map format-record data)))

(define (report-errors reporter data)
  "Logs validation errors."
  (update-counts reporter 'error (length data))
  (append-to-file (: path reporter)
                  (list "Validation Errors:")
                  data))

(define (deinit-reporter reporter)
  "Finalizes the report and closes handles."
  (append-to-file (: path reporter) '()))

(define (format-record record)
  "Formats a data record for output."
  (join " | " record))
