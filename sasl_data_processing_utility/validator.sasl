(define (validate-data data)
  "Validates the cleaned data."
  (if (null? data)
      #f
      (and (check-schema data) (check-types data))))

(define (check-schema data)
  "Checks if data matches the expected schema."
  (every (lambda (record)
           (and (length=? 3 record) (string? (first record))))
         data))

(define (check-types data)
  "Basic type checking for integrity."
  (every (lambda (x)
           (or (string? x) (number? x)))
         data))
