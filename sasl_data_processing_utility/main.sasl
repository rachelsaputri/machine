(import 'ingester' 'transformer' 'validator' 'reporter')

(define (process-data source-path target-path)
  "Main entry point for the data processing pipeline."
  (let ((raw-data (ingest-file source-path)))
    (if (null? raw-data)
        (log-message "No data to process.")
        (let ((cleaned-data (transform-data raw-data))
              (reporter (init-reporter target-path)))
          (if (validate-data cleaned-data)
              (begin
                (report-clean reporter cleaned-data)
                (log-message "Processing complete."))
              (begin
                (report-errors reporter cleaned-data)
                (log-message "Validation failed."))
              (deinit-reporter reporter)))))))

(define (main)
  "Starts the pipeline with default configuration."
  (process-data "./input/data.csv" "./output/report.txt"))
