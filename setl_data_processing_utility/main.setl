-- SETL Data Processing Utility - Main Entry Point
-- Usage: setl main.setl [input_file] [output_file]

input_file := "";
output_file := "";

if args# > 0 then
    input_file := args[1];
end;

if args# > 1 then
    output_file := args[2];
end;

if input_file = "" then
    put("Usage: setl main.setl input_file [output_file]");
    quit;
end;

-- Import modules
include "processor.setl";
include "validator.setl";
include "reporter.setl";

-- Initialize processing
raw_data := read_data(input_file);
if raw_data = {} then
    put("Error: Could not read input file");
    quit;
end;

-- Validate data
valid_records := validate_data(raw_data);
put("Valid records: " | valid_records#);

-- Transform/Process data
processed_records := process_data(valid_records);

-- Generate report
if output_file /= "" then
    write_data(processed_records, output_file);
    put("Output written to: " | output_file);
else
    put("Processed records: " | processed_records#);
end;

quit;
