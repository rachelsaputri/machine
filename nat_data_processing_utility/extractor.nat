DEFINE DATA
1 RAW-DATA    TYPE TEXT(1000)
1 DELIMITER   TYPE TEXT(1)
1 RECORDS     TYPE TEXT(1000)
1 RECORD-COUNT TYPE INTEGER
END DEFINE

PROGRAM EXTRACT_DATA
  ARGUMENTS INPUT-FILE

  OPEN INPUT INPUT-FILE
  IF STATUS != 0 THEN
    DISPLAY 'ERROR: Could not open input file: ', INPUT-FILE
    RETURN
  END IF

  RECORDS = ''
  RECORD-COUNT = 0

  REPEAT
    READ INPUT INPUT-FILE INTO RAW-DATA
    IF STATUS != 0 THEN
      EXIT REPEAT
    END IF
    RECORD-COUNT = RECORD-COUNT + 1
    RECORDS = RECORDS || RAW-DATA || CHAR(10)
  END REPEAT

  CLOSE INPUT INPUT-FILE

  IF RECORD-COUNT > 0 THEN
    DISPLAY 'Extracted ', RECORD-COUNT, ' records.'
    STATUS = 0
  ELSE
    DISPLAY 'No records extracted.'
    STATUS = 1
  END IF
END PROGRAM
