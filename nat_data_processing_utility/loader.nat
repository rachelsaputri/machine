DEFINE DATA
1 TARGET-FILE TYPE TEXT(256)
1 TRANSFORMED-RECORDS TYPE TEXT(1000)
1 LINES         TYPE INTEGER
1 I             TYPE INTEGER
1 LINE-ITEM     TYPE TEXT(256)
END DEFINE

PROGRAM LOAD_DATA
  ARGUMENTS TARGET-FILE

  INCLUDE 'transformer.nat'

  OPEN OUTPUT TARGET-FILE
  IF STATUS != 0 THEN
    DISPLAY 'ERROR: Could not open output file: ', TARGET-FILE
    RETURN
  END IF

  LINES = LINE-NO
  I = 1

  REPEAT
    LINE-ITEM = LINE(I)
    WRITE OUTPUT TARGET-FILE FROM LINE-ITEM
    I = I + 1
  UNTIL I > LINES

  CLOSE OUTPUT TARGET-FILE

  DISPLAY 'Loaded data to ', TARGET-FILE
  STATUS = 0
END PROGRAM
