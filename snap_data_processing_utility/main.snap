;; main.snap - Core Pipeline Orchestration

;; Import helper modules
import 'calculate_stats.snap'
import 'filter_nulls.snap'
import 'pipeline.snap'
import 'validate_data.snap'

;; Global State
(set global_state to (list "initialized"))

;; Main Entry Point
(define start-pipeline (data-source-url))
  ;; Step 1: Initialize
  (set global_state to (list "starting"))
  
  ;; Step 2: Ingest Data
  (call ingest-data (data-source-url))
  
  ;; Step 3: Clean Data
  (call filter-nulls (get-last-batch))
  
  ;; Step 4: Validate Data
  (call validate-data (get-cleaned-batch))
  
  ;; Step 5: Transform Data
  (call transform-data (get-validated-batch))
  
  ;; Step 6: Calculate Stats
  (call calculate-stats (get-transformed-batch))
  
  ;; Step 7: Finalize
  (set global_state to (list "completed"))
  (report "Pipeline Finished")

;; Expose public API
(set public-api to (list start-pipeline))
