;; validate_data.snap - Validation Logic

;; Check Schema Compliance
(define passes-schema-check? (record))
  (if (has-key? (record) "id")
    (if (has-key? (record) "value"))
      (if (is-numeric? (value-of (record "value"))))
        (report true)
      else
        (report false)
      )
    else
      (report false)
    )
  else
    (report false)
  )

;; Is Numeric Check
(define is-numeric? (value))
  (if (is (type-of (value)) equal-to "number"))
    (report true)
  else
    (report false)
  )

;; Report Validation Errors
(define report-errors (failed-items))
  (for each (item) in (failed-items))
    (print "Validation Failed for item: " (item))
  )
