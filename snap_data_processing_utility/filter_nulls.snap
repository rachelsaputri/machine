;; filter_nulls.snap - Data Cleansing Logic

;; Check if value is null
(define is-null? (value))
  (if (is (value) equal-to (empty)))
    (report true)
  else
    (report false)
  )

;; Remove Nulls from List
(define remove-nulls (list))
  (set result to (empty-list))
  (for each (x) in (list))
    (if (not (is-null? (x))))
      (append-to-list (result) (x))
    )
  (report result)

;; Sanitize String Fields
(define sanitize-string (str))
  (if (is (str) equal-to (null)))
    (report "")
  else
    (report (trim (str)))
  )
