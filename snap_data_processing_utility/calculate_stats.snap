;; calculate_stats.snap - Statistics Calculation

;; Calculate Average
(define calculate-average (list))
  (if (is-empty? (list)))
    (report 0)
  else
    (set sum to (sum-of (list)))
    (set count to (length-of (list)))
    (report (divide (sum) (count)))
  )

;; Calculate Min
(define calculate-min (list))
  (if (is-empty? (list)))
    (report 0)
  else
    (sort (list) ascending)
    (report (first-of (list)))
  )

;; Calculate Max
(define calculate-max (list))
  (if (is-empty? (list)))
    (report 0)
  else
    (sort (list) descending)
    (report (first-of (list)))
  )

;; Sum of List
(define sum-of (list))
  (set total to 0)
  (for each (num) in (list))
    (set total to (add (total) (num)))
  (report total)
