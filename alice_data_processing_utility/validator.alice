// Validator Module for Alice Data Processing Utility

function validateData(records) {
    for each record in records {
        if not isValidRecord(record) {
            return false;
        }
    }
    return true;
}

function isValidRecord(record) {
    if not hasValidName(record.name) {
        return false;
    }
    if not hasValidAge(record.age) {
        return false;
    }
    if not hasValidCity(record.city) {
        return false;
    }
    return true;
}

function hasValidName(name) {
    return not isEmpty(name) && length(name) > 0;
}

function hasValidAge(age) {
    return isNumber(age) && age >= 0 && age <= 120;
}

function hasValidCity(city) {
    return not isEmpty(city) && length(city) > 0;
}
