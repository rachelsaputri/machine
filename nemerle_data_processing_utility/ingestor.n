namespace DataProcessing

using System
using System.Collections.Generic
using System.IO
using System.Linq
using DataProcessing.Models

module DataProcessing.Ingestor
{
    public class DataIngestor
    {
        public List<DataRecord> Ingest(string filePath, string format = "csv")
        {
            if (!File.Exists(filePath))
                throw new FileNotFoundException($"Input file not found: {filePath}");

            var records = new List<DataRecord>();
            var lines = File.ReadAllLines(filePath);
            
            for (int i = 0; i < lines.Length; i++)
            {
                try
                {
                    var line = lines[i];
                    if (string.IsNullOrWhiteSpace(line))
                        continue;

                    var record = ParseLine(line, format, i + 1);
                    records.Add(record);
                }
                catch (Exception ex)
                {
                    // Log or handle individual line errors gracefully
                    System.Console.WriteLine($"Warning: Could not parse line {i + 1}: {ex.Message}");
                }
            }
            
            return records;
        }

        private DataRecord ParseLine(string line, string format, int lineNumber)
        {
            var fields = new Dictionary<string, string>();
            
            if (format == "csv")
            {
                var values = line.Split(',');
                for (int i = 0; i < values.Length; i++)
                {
                    var key = $"Field{i}";
                    fields[key] = values[i].Trim();
                }
            }
            else if (format == "json")
            {
                // Simple JSON parsing for flat objects
                var json = line.Trim();
                if (json.StartsWith("{") && json.EndsWith("}"))
                {
                    var content = json.Substring(1, json.Length - 2);
                    var pairs = content.Split(',');
                    foreach (var pair in pairs)
                    {
                        var kv = pair.Split(':');
                        if (kv.Length == 2)
                        {
                            var key = kv[0].Trim().Trim('\"');
                            var value = kv[1].Trim().Trim('\"');
                            fields[key] = value;
                        }
                    }
                }
            }
            else
            {
                // Default: split by whitespace
                var parts = line.Split(new char[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
                for (int i = 0; i < parts.Length; i++)
                {
                    fields[$"Part{i}"] = parts[i];
                }
            }

            return new DataRecord
            {
                Fields = fields,
                SourceFile = "<unknown>", // Will be set by caller
                LineNumber = lineNumber
            };
        }

        public void SetSourceFile(List<DataRecord> records, string sourceFile)
        {
            foreach (var record in records)
            {
                record = record with { SourceFile = sourceFile };
            }
        }
    }
}
