! TACL Data Processing Utility - Configuration
! Define input and output file paths
DEFINE INPUT_PATH = '/data/input/'
DEFINE OUTPUT_PATH = '/data/output/'

! Define processing parameters
DEFINE BATCH_SIZE = 100
DEFINE DELIMITER = ','
DEFINE ENCODING = 'ASCII'

! Define transformation rules
DEFINE TRANSFORM_RULES = 'DATE_FORMAT,UPPERCASE,CAPITALIZE_FIRST'

! Define validation criteria
DEFINE VALIDATION_RULES = 'NON_EMPTY,FIXED_LENGTH,NUMERIC_CHECK'

! Logging settings
DEFINE LOG_LEVEL = 'INFO'
DEFINE LOG_FORMAT = '[TIMESTAMP] [LEVEL] MESSAGE'
