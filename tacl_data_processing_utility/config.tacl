/* TACL Data Processing Utility - Configuration */

/* Logging configuration */
$DEFINE VAR LOGLEVEL = 2  /* 0=errors only, 1=warnings, 2=info, 3=debug */
$DEFINE VAR LOGTOFILE = TRUE

/* Data validation settings */
$DEFINE VAR STRICTVALIDATION = TRUE
$DEFINE VAR ALLOWBLANKFIELDS = FALSE
$DEFINE VAR MAXFIELDLENGTH = 256

/* Data transformation settings */
$DEFINE VAR CONVERTTOUPPER = TRUE
$DEFINE VAR TRIMSPACES = TRUE
$DEFINE VAR STANDARDIZEDELIMITERS = TRUE

/* Reporting settings */
$DEFINE VAR DETAILEDREPORT = TRUE
$DEFINE VAR INCLUDETIMESTAMPS = TRUE
$DEFINE VAR REPORTFORMAT = TEXT

/* Error handling settings */
$DEFINE VAR STOPONERROR = FALSE
$DEFINE VAR MAXERRORS = 1000
$DEFINE VAR RECOVERABLEERRORS = TRUE

/* Display confirmation */
$DISPLAY "Configuration loaded successfully"
$DISPLAY "Logging Level: $LOGLEVEL"
$DISPLAY "Strict Validation: $STRICTVALIDATION"
