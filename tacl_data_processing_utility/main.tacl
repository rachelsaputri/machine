! TACL Data Processing Utility - Main Entry Point
! This script initializes the data processing pipeline.

DEFINE INPUT_FILE = 'INPUT.TXT'
DEFINE OUTPUT_FILE = 'OUTPUT.TXT'
DEFINE REPORT_FILE = 'REPORT.TXT'
DEFINE LOG_FILE = 'LOG.TXT'

! Read configuration
INCLUDE config.tacl

! Start processing
PROCESS_DATA INPUT_FILE OUTPUT_FILE REPORT_FILE LOG_FILE

! End program
TERMINATE
