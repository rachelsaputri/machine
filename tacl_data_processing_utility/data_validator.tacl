! TACL Data Processing Utility - Data Validator
! Functions for validating data integrity

VALIDATE_RECORD RECORD
    ! Check if record is non-empty
    IF LENGTH(TRIM(RECORD)) = 0 THEN
        RETURN FALSE
    END IF
    
    ! Check for fixed length (example: 10 characters)
    IF LENGTH(RECORD) != 10 THEN
        RETURN FALSE
    END IF
    
    ! Check if numeric (example: first 5 characters)
    SET NUMERIC_PART = SUBSTRING(RECORD, 1, 5)
    IF NOT IS_NUMERIC(NUMPART) THEN
        RETURN FALSE
    END IF
    
    ! All checks passed
    RETURN TRUE
END VALIDATE_RECORD

IS_NUMERIC TEXT
    SET NUMERIC_CHARS = '0123456789'
    SET VALID = TRUE
    SET I = 1
    LOOP WHILE I <= LENGTH(TEXT)
        SET CHAR = SUBSTRING(TEXT, I, 1)
        IF INDEX(NUMERIC_CHARS, CHAR) = 0 THEN
            SET VALID = FALSE
            BREAK LOOP
        END IF
        SET I = I + 1
    END LOOP
    RETURN VALID
END IS_NUMERIC
