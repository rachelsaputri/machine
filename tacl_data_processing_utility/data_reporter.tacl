/* TACL Data Processing Utility - Data Reporter */

/* Reporter configuration */
$DEFINE VAR REPORTDETAILED = $DETAILEDREPORT
$DEFINE VAR REPORTTIMESTAMP = $INCLUDETIMESTAMPS
$DEFINE VAR REPORTFORMAT = $REPORTFORMAT

/* Generate processing report */
$SUBROUTINE GENERATEPROCESSINGREPORT TOTALRECORDS ERRORCOUNT PROCESSEDCOUNT
    $DEFINE VAR REPORTSTATUS = 0
    $DEFINE VAR TIMESTAMP = $GETTIMESTAMP()
    
    $DISPLAY "Generating processing report..."
    
    /* Open report file */
    $IF NOT OPEN($REPORTFILE, APPEND) THEN
        $DISPLAY "ERROR: Cannot open report file"
        $SET VAR REPORTSTATUS = 1
        $RETURN $REPORTSTATUS
    $ENDIF
    
    /* Write report header */
    $WRITE REPORT "=================================================================="
    $IF $REPORTTIMESTAMP = TRUE THEN
        $WRITE REPORT "TACL Data Processing Report - $TIMESTAMP"
    $ELSE
        $WRITE REPORT "TACL Data Processing Report"
    $ENDIF
    $WRITE REPORT "=================================================================="
    $WRITE REPORT ""
    
    /* Write summary statistics */
    $WRITE REPORT "Processing Summary:"
    $WRITE REPORT "  Total Records Processed: $TOTALRECORDS"
    $WRITE REPORT "  Successfully Processed: $PROCESSEDCOUNT"
    $WRITE REPORT "  Records with Errors: $ERRORCOUNT"
    $WRITE REPORT ""
    
    /* Calculate success rate */
    $DEFINE VAR SUCCESSRATE = 0
    $IF $TOTALRECORDS > 0 THEN
        $SET VAR SUCCESSRATE = ($PROCESSEDCOUNT / $TOTALRECORDS) * 100
    $ENDIF
    $WRITE REPORT "Success Rate: $SUCCESSRATE%"
    $WRITE REPORT ""
    
    /* Write detailed error information if configured */
    $IF $REPORTDETAILED = TRUE THEN
        $WRITE REPORT "Error Details:"
        $WRITE REPORT "  Check the error log file for detailed error information"
        $WRITE REPORT "  Error log location: $ERRORLOGFILE"
        $WRITE REPORT ""
    $ENDIF
    
    /* Write conclusion */
    $IF $ERRORCOUNT = 0 THEN
        $WRITE REPORT "Processing completed successfully with no errors."
    $ELSE
        $WRITE REPORT "Processing completed with $ERRORCOUNT error(s) detected."
    $ENDIF
    $WRITE REPORT ""
    $WRITE REPORT "=================================================================="
    $WRITE REPORT "End of Report"
    $WRITE REPORT "=================================================================="
    
    /* Close report file */
    $CLOSE $REPORTFILE
    
    $DISPLAY "Processing report generated successfully"
    $RETURN $REPORTSTATUS
$ENDSUBROUTINE

/* Generate individual record error report */
$SUBROUTINE GENERATEERRORREPORT RECORDNUMBER ERRORMESSAGE
    $DEFINE VAR ERRORSTATUS = 0
    
    /* Open error log file */
    $DEFINE VAR ERRORLOGFILE = "ERROR.LOG"
    $IF NOT OPEN($ERRORLOGFILE, APPEND) THEN
        $DISPLAY "ERROR: Cannot open error log file"
        $RETURN 1
    $ENDIF
    
    /* Write error information */
    $DEFINE VAR TIMESTAMP = $GETTIMESTAMP()
    $WRITE ERRORLOG "[$TIMESTAMP] Record $RECORDNUMBER: $ERRORMESSAGE"
    
    /* Close error log file */
    $CLOSE $ERRORLOGFILE
    
    $RETURN $ERRORSTATUS
$ENDSUBROUTINE

/* Display summary statistics */
$SUBROUTINE DISPLAYSUMMARY TOTALRECORDS ERRORCOUNT PROCESSEDCOUNT
    $DISPLAY "=================================================="
    $DISPLAY "PROCESSING SUMMARY"
    $DISPLAY "=================================================="
    $DISPLAY "Total Records: $TOTALRECORDS"
    $DISPLAY "Successfully Processed: $PROCESSEDCOUNT"
    $DISPLAY "Errors Encountered: $ERRORCOUNT"
    
    $DEFINE VAR SUCCESSRATE = 0
    $IF $TOTALRECORDS > 0 THEN
        $SET VAR SUCCESSRATE = ($PROCESSEDCOUNT / $TOTALRECORDS) * 100
    $ENDIF
    $DISPLAY "Success Rate: $SUCCESSRATE%"
    $DISPLAY "=================================================="
$ENDSUBROUTINE

/* Utility function to get current timestamp */
$SUBROUTINE GETTIMESTAMP
    /* Return current date and time */
    $DEFINE VAR CURRENTDATE = $GETDATE()
    $DEFINE VAR CURRENTTIME = $GETTIME()
    $DEFINE VAR TIMESTAMP = "$CURRENTDATE $CURRENTTIME"
    
    $RETURN $TIMESTAMP
$ENDSUBROUTINE

$DISPLAY "Data Reporter initialized successfully"
