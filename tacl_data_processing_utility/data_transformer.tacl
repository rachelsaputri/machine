! TACL Data Processing Utility - Data Transformer
! Functions for transforming data

TRANSFORM_RECORD RECORD
    ! Apply date format transformation
    SET RECORD = FORMAT_DATE(RECORD)
    
    ! Apply uppercase transformation
    SET RECORD = CONVERT_TO_UPPERCASE(RECORD)
    
    ! Apply capitalize first letter transformation
    SET RECORD = CAPITALIZE_FIRST_LETTER(RECORD)
    
    RETURN RECORD
END TRANSFORM_RECORD

FORMAT_DATE RECORD
    ! Example: Convert 'MM/DD/YYYY' to 'YYYY-MM-DD'
    SET DATE_PARTS = SPLIT(RECORD, '/')
    IF LENGTH(DATE_PARTS) = 3 THEN
        SET FORMATTED_DATE = DATE_PARTS[3] + '-' + DATE_PARTS[1] + '-' + DATE_PARTS[2]
        SET RECORD = REPLACE(RECORD, DATE_PARTS[1] + '/' + DATE_PARTS[2] + '/' + DATE_PARTS[3], FORMATTED_DATE)
    END IF
    RETURN RECORD
END FORMAT_DATE

CONVERT_TO_UPPERCASE TEXT
    RETURN UPPER(TEXT)
END CONVERT_TO_UPPERCASE

CAPITALIZE_FIRST_LETTER TEXT
    IF LENGTH(TEXT) > 0 THEN
        SET FIRST_CHAR = SUBSTRING(TEXT, 1, 1)
        SET REST_OF_TEXT = SUBSTRING(TEXT, 2)
        RETURN UPPER(FIRST_CHAR) + REST_OF_TEXT
    ELSE
        RETURN TEXT
    END IF
END CAPITALIZE_FIRST_LETTER
