import transformer;
import validator;
import reporter;

function process(data, config) {
    if (!data || data.length === 0) {
        return {
            status: "error",
            message: "No data provided for processing",
            results: []
        };
    }

    const results = [];
    for (let i = 0; i < data.length; i++) {
        const item = data[i];
        const valid = validator.validate_item(item, config);

        if (valid) {
            const transformed = transformer.transform_item(item, config);
            results.push({
                original: item,
                transformed: transformed,
                status: "processed"
            });
        } else {
            results.push({
                original: item,
                transformed: null,
                status: "rejected"
            });
        }
    }

    return {
        status: "success",
        message: "Processing complete",
        results: results,
        summary: {
            total: data.length,
            processed: results.filter(r => r.status === "processed").length,
            rejected: results.filter(r => r.status === "rejected").length
        }
    };
}

function parse_line(line) {
    const parts = line.split(",");
    return {
        id: parts[0] ? parts[0].trim() : null,
        status: parts[1] ? parts[1].trim() : null,
        category: parts[2] ? parts[2].trim() : null
    };
}
