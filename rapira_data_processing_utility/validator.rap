function validate(data, config) {
    if (!data) {
        return {
            status: "error",
            message: "No data provided",
            data: []
        };
    }

    const parsed_data = [];
    const lines = data.split("\n");

    for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (line.length === 0) continue;

        const item = parse_line(line);
        const valid = validate_item(item, config);

        if (valid) {
            parsed_data.push(item);
        } else {
            log("Validation failed for line: " + line);
        }
    }

    return {
        status: "success",
        message: "Validation complete",
        data: parsed_data
    };
}

function validate_item(item, config) {
    if (!item) return false;

    const errors = [];

    if (config.strict_validation) {
        if (!item.id) {
            errors.push("Missing ID");
        }
        if (!item.status) {
            errors.push("Missing Status");
        }
    }

    if (errors.length > 0) {
        log("Validation errors: " + errors.join(", "));
        return false;
    }

    return true;
}

function parse_line(line) {
    const parts = line.split(",");
    return {
        id: parts[0] ? parts[0].trim() : null,
        status: parts[1] ? parts[1].trim() : null,
        category: parts[2] ? parts[2].trim() : null
    };
}

function log(message) {
    print("[VALIDATOR] " + message);
}
