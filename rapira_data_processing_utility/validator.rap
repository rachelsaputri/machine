/**
 * Module responsible for validating transformed data.
 */

module ValidatorModule;

function validator(data) {
    print("Validating data...\n");
    
    var isValid = true;
    
    for record in data.records {
        if record.id == null || record.value == null || record.status == null {
            print("Validation failed: Missing fields in record.");
            isValid = false;
            break;
        }
        if !isNumber(record.id) {
            print("Validation failed: Invalid ID format.");
            isValid = false;
            break;
        }
        if record.status != "0" && record.status != "1" {
            print("Validation failed: Invalid status format.");
            isValid = false;
            break;
        }
    }
    
    if isValid {
        print("Data validation passed.\n");
    } else {
        print("Data validation failed.\n");
    }
    
    return isValid;
}
