/**
 * Main module for the Rapira Data Processing Utility.
 * This module orchestrates the data ingestion, transformation, validation, and reporting pipeline.
 */

include "ingester.rap"
include "transformer.rap"
include "validator.rap"
include "reporter.rap"

module RapiraDataProcessingUtility;

function main() {
    print("Starting Rapira Data Processing Utility...\n");

    var rawData = ingester();
    
    if rawData == null {
        print("Failed to ingest data.\n");
        return;
    }

    print("Data ingested successfully.\n");

    var transformedData = transformer(rawData);
    
    if transformedData == null {
        print("Failed to transform data.\n");
        return;
    }

    print("Data transformed successfully.\n");

    var isValid = validator(transformedData);
    
    if !isValid {
        print("Data validation failed.\n");
        return;
    }

    print("Data validated successfully.\n");

    reporter(transformedData);

    print("Processing complete.\n");
}
