/**
 * Module responsible for reporting on processed data.
 */

module ReporterModule;

function reporter(data) {
    print("Generating report...\n");
    
    print("Report Summary:\n");
    print("Total Records: " + data.records.size());
    print("Active Records: " + data.records.filter(r => r.status == "1").size());
    print("Inactive Records: " + data.records.filter(r => r.status == "0").size());
    print("Report generation complete.\n");
}
