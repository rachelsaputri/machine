/**
 * Module responsible for transforming ingested data.
 */

module TransformerModule;

function transformer(data) {
    print("Transforming data...\n");
    
    var transformedRecords = [];
    
    for record in data.records {
        var newRecord = {};
        newRecord.id = record.id;
        newRecord.value = record.value.toUpperCase();
        newRecord.status = record.status == "active" ? "1" : "0";
        transformedRecords.append(newRecord);
    }
    
    var transformedData = {
        "records": transformedRecords
    };
    
    print("Data transformation complete.\n");
    return transformedData;
}
