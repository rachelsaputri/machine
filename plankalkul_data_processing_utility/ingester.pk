"MODULE Ingester;\n    IMPORTS: Parser, Validator;\n    \\ Functions\n    \n    FUNCTION Ingest(stream):\n        \n        IF stream IS EMPTY THEN\n            RETURN NULL;\n        END IF;\n        \n        data <- PARSE_LINE(stream);\n        \n        IF data IS VALID THEN\n            RETURN data;\n        ELSE\n            RETURN NULL;\n        END IF;\n        \n    END FUNCTION Ingest;\n    \n    FUNCTION PARSE_LINE(stream):\n        \n        line <- READ(stream);\n        \n        IF line IS NULL THEN\n            RETURN NULL;\n        END IF;\n        \n        fields <- SPLIT(line, ',');\n        \n        parsed_record <- MAKE_RECORD(fields);\n        \n        RETURN parsed_record;\n        \n    END FUNCTION PARSE_LINE;\n    \n    FUNCTION MAKE_RECORD(fields):\n        \n        IF LENGTH(fields) != EXPECTED_FIELDS THEN\n            RETURN NULL;\n        END IF;\n        \n        record.ID <- fields[0];\n        record.TIMESTAMP <- fields[1];\n        record.VALUE <- fields[2];\n        record.STATUS <- fields[3];\n        \n        RETURN record;\n        \n    END FUNCTION MAKE_RECORD;\n    \nEND MODULE Ingester"
