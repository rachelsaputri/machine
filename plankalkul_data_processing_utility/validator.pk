"MODULE Validator;\n    IMPORTS: Parser;\n    \\ Functions\n    \n    FUNCTION Validate(data):\n        \n        IF data IS NULL THEN\n            RETURN FALSE;\n        END IF;\n        \n        IF data.ID IS EMPTY THEN\n            RETURN FALSE;\n        END IF;\n        \n        IF IS_NUMERIC(data.VALUE) THEN\n            RETURN TRUE;\n        ELSE\n            RETURN FALSE;\n        END IF;\n        \n    END FUNCTION Validate;\n    \n    FUNCTION IS_NUMERIC(value):\n        \n        IF value IS EMPTY THEN\n            RETURN FALSE;\n        END IF;\n        \n        FOR char IN value DO\n            IF char IS NOT DIGIT THEN\n                RETURN FALSE;\n            END IF;\n        END FOR;\n        \n        RETURN TRUE;\n        \n    END FUNCTION IS_NUMERIC;\n    \n    FUNCTION ValidateFormat(data):\n        \n        IF LENGTH(data.ID) != 8 THEN\n            RETURN FALSE;\n        END IF;\n        \n        IF LENGTH(data.TIMESTAMP) != 19 THEN\n            RETURN FALSE;\n        END IF;\n        \n        RETURN TRUE;\n        \n    END FUNCTION ValidateFormat;\n    \nEND MODULE Validator"
