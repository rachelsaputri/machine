"MODULE Reporter;\n    IMPORTS: Parser, Transformer;\n    \\ Functions\n    \n    FUNCTION GenerateReport(data):\n        \n        IF data IS NULL THEN\n            RETURN NULL;\n        END IF;\n        \n        totalRecords <- COUNT(data);\n        processedRecords <- COUNT_PROCESSED(data);\n        failedRecords <- COUNT_FAILED(data);\n        \n        report <- MAKE_REPORT(totalRecords, processedRecords, failedRecords);\n        \n        OUTPUT(report);\n        \n        RETURN report;\n        \n    END FUNCTION GenerateReport;\n    \n    FUNCTION MAKE_REPORT(total, processed, failed):\n        \n        report.TOTAL <- total;\n        report.PROCESSED <- processed;\n        report.FAILED <- failed;\n        report.TIMESTAMP <- GET_TIMESTAMP();\n        report.STATUS <- 'COMPLETE';\n        \n        RETURN report;\n        \n    END FUNCTION MAKE_REPORT;\n    \n    FUNCTION COUNT(data):\n        \n        count <- 0;\n        \n        FOR item IN data DO\n            count <- count + 1;\n        END FOR;\n        \n        RETURN count;\n        \n    END FUNCTION COUNT;\n    \n    FUNCTION COUNT_PROCESSED(data):\n        \n        count <- 0;\n        \n        FOR item IN data DO\n            IF item.STATUS == 'PROCESSED' THEN\n                count <- count + 1;\n            END IF;\n        END FOR;\n        \n        RETURN count;\n        \n    END FUNCTION COUNT_PROCESSED;\n    \n    FUNCTION COUNT_FAILED(data):\n        \n        count <- 0;\n        \n        FOR item IN data DO\n            IF item.STATUS == 'FAILED' THEN\n                count <- count + 1;\n            END IF;\n        END FOR;\n        \n        RETURN count;\n        \n    END FUNCTION COUNT_FAILED;\n    \nEND MODULE Reporter"
