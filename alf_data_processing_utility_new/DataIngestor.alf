// DataIngestor: Handles data ingestion from various sources

class DataIngestor {
    private string sourcePath;
    private list<Record> records;

    // Constructor
    constructor(string path) {
        this.sourcePath = path;
        this.records = new list<Record>();
    }

    // Load data from the specified source path
    load() {
        println("Ingesting data from: " + this.sourcePath);
        // Simulate reading from a file
        let lines = readFile(this.sourcePath);
        for (let line : lines) {
            if (line != "") {
                let fields = split(line, ",");
                let record = new Record(fields);
                this.records.add(record);
            }
        }
        println("Ingestion complete. Total records: " + this.records.size());
        return this;
    }

    // Get the number of records ingested
    getRecordCount() {
        return this.records.size();
    }

    // Get all ingested records
    getRecords() {
        return this.records;
    }
}
