MODULE REPORTER

IMPORTS IO

FUNCTION GenerateReport(Records: LIST OF DataRecord, OutputFile: STRING) RETURNS INTEGER
    DECLARE 
        FileHandle: INTEGER;
        Index: INTEGER;
        CurrentRecord: DataRecord;
        ReportLine: STRING;
        ErrorCode: INTEGER := 0;
    END DECLARE;

    OPEN FileHandle FOR WRITE IN OutputFile;
    IF FileHandle < 0 THEN
        RETURN -1;
    END IF;

    WRITE FileHandle "ID,Value,Timestamp";

    FOR Index := 1 TO LENGTH(Records) DO
        CurrentRecord := RECORDS[Index];
        ReportLine := INTEGER_TO_STRING(CurrentRecord.ID) || "," || 
                      CurrentRecord.Value || "," || 
                      DATETIME_TO_STRING(CurrentRecord.Timestamp, "YYYY-MM-DD HH:MM:SS");
        WRITE FileHandle ReportLine;
    END FOR;

    CLOSE FileHandle;
    RETURN ErrorCode;
END FUNCTION
