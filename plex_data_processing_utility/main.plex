RECORD DataRecord
    ID: INTEGER;
    Value: STRING;
    Timestamp: DATETIME;
END RECORD;

MODULE PLEXDataProcessingUtility

IMPORTS INGESTER, TRANSFORMER, VALIDATOR, REPORTER

PROCEDURE Main()
    DECLARE 
        SourceFile: STRING := "input_data.csv";
        TargetFile: STRING := "output_report.txt";
        RecordList: LIST OF DataRecord;
        ProcessedList: LIST OF DataRecord;
        ValidatedList: LIST OF DataRecord;
        Status: INTEGER;
    END DECLARE;

    // 1. Ingest Data
    Status := INGESTER::LoadFromFile(SourceFile, RecordList);
    IF Status <> 0 THEN
        WRITE "ERROR: Failed to ingest data from " || SourceFile;
        RETURN;
    END IF;
    WRITE "Ingested " || LENGTH(RecordList) || " records.";

    // 2. Transform Data
    ProcessedList := TRANSFORMER::ApplyTransformations(RecordList);
    WRITE "Transformed " || LENGTH(ProcessedList) || " records.";

    // 3. Validate Data
    ValidatedList := VALIDATOR::CheckIntegrity(ProcessedList);
    WRITE "Validated " || LENGTH(ValidatedList) || " records.";

    // 4. Report Data
    Status := REPORTER::GenerateReport(ValidatedList, TargetFile);
    IF Status <> 0 THEN
        WRITE "ERROR: Failed to generate report.";
    ELSE
        WRITE "Report successfully generated at " || TargetFile;
    END IF;
END PROCEDURE
