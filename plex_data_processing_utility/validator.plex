MODULE VALIDATOR

FUNCTION CheckIntegrity(Records: LIST OF DataRecord) RETURNS LIST OF DataRecord
    DECLARE 
        ValidList: LIST OF DataRecord;
        CurrentRecord: DataRecord;
        Index: INTEGER;
        IsValid: BOOLEAN;
    END DECLARE;

    FOR Index := 1 TO LENGTH(Records) DO
        CurrentRecord := RECORDS[Index];
        IsValid := TRUE;
        
        // Validation Rule 1: ID must be positive
        IF CurrentRecord.ID <= 0 THEN
            IsValid := FALSE;
        END IF;
        
        // Validation Rule 2: Value must not be empty
        IF LENGTH(CurrentRecord.Value) = 0 THEN
            IsValid := FALSE;
        END IF;
        
        IF IsValid THEN
            APPEND ValidList CurrentRecord;
        END IF;
    END FOR;

    RETURN ValidList;
END FUNCTION
