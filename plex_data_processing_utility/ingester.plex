MODULE INGESTER

IMPORTS SYSTEM, IO

FUNCTION LoadFromFile(filePath: STRING, OUT list: LIST OF DataRecord) RETURNS INTEGER
    DECLARE 
        FileHandle: INTEGER;
        Line: STRING;
        CurrentRecord: DataRecord;
        RecordCount: INTEGER := 0;
        ErrorCode: INTEGER := 0;
    END DECLARE;

    OPEN FileHandle FOR READ IN filePath;
    IF FileHandle < 0 THEN
        RETURN -1; // File open error
    END IF;

    WHILE READ FileHandle INTO Line DO
        // Simple CSV parsing: ID,Value,Timestamp
        // Note: PLEX string parsing is rudimentary; robust parsing requires external lib
        IF LENGTH(Line) > 0 THEN
            TRY_PARSE Line INTO CurrentRecord;
            APPEND list CurrentRecord;
            RecordCount := RecordCount + 1;
        END IF;
    END WHILE;

    CLOSE FileHandle;
    RETURN ErrorCode;
END FUNCTION

PROCEDURE TRY_PARSE(Source: STRING, OUT Dest: DataRecord)
    DECLARE 
        Parts: LIST OF STRING;
        IdPart: STRING;
        ValPart: STRING;
        TsPart: STRING;
    END DECLARE;

    PARTS := SPLIT(Source, ",");
    IF LENGTH(PARTS) >= 3 THEN
        IdPart := TRIM(PARTS[1]);
        ValPart := TRIM(PARTS[2]);
        TsPart := TRIM(PARTS[3]);
        
        Dest.ID := PARSE_INTEGER(IdPart, 0);
        Dest.Value := ValPart;
        Dest.Timestamp := PARSE_DATETIME(TsPart, "YYYY-MM-DD HH:MM:SS");
    END IF;
END PROCEDURE
