MODULE TRANSFORMER

IMPORTS SYSTEM, MATH

FUNCTION ApplyTransformations(Records: LIST OF DataRecord) RETURNS LIST OF DataRecord
    DECLARE 
        ProcessedList: LIST OF DataRecord;
        CurrentRecord: DataRecord;
        Index: INTEGER;
    END DECLARE;

    FOR Index := 1 TO LENGTH(Records) DO
        CurrentRecord := RECORDS[Index];
        
        // Example Transformation: Uppercase the value
        CurrentRecord.Value := TO_UPPER(CurrentRecord.Value);
        
        // Example Transformation: Adjust timestamp by offset
        // Note: PLEX datetime math might require custom helpers
        // CurrentRecord.Timestamp := CurrentRecord.Timestamp + INTERVAL(0,0,1,0,0);
        
        APPEND ProcessedList CurrentRecord;
    END FOR;

    RETURN ProcessedList;
END FUNCTION
